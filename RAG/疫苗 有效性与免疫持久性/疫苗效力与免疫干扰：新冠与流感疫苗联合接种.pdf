   <dc:creator>
    <rdf:Seq>
     <rdf:li>JIM WEST/SCIENCE PHOTO LIBRARY</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Editorial use only  &#xA;Senior man being injected with a vaccine against SARS-CoV-2, the cause of Covid-19. The vaccine stimulates an immune response, causing the body to produce antibodies against the virus. This means that the body is primed to attack the virus should it be encountered after vaccination, preventing disease. Photographed in Detroit, Michigan, USA.</rdf:li>
    </rdf:Alt>
   </dc:description>
