APP_NAME=vaccine-ai-backend
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

DASHSCOPE_API_KEY=your_api_key_here

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Main factual Q&A generation only.
QWEN_MODEL=qwen3.8-flash
# Router, clarification, conversational replies, and science-image brief organization.
QWEN_LIGHTWEIGHT_MODEL=qwen3.8-flash
DASHSCOPE_IMAGE_MODEL=wan2.7-image-pro
WAN_IMAGE_SIZE=2K
# wan2.7 image editing requires both input dimensions to be at least 240 px.
WAN_EDIT_MIN_INPUT_SIDE_PX=240
Z_IMAGE_MODEL=z-image-turbo
Z_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
Z_IMAGE_SIZE=1024*1024

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

QWEN_TIMEOUT_SECONDS=60
WAN_IMAGE_TIMEOUT_SECONDS=300
Z_IMAGE_TIMEOUT_SECONDS=90

GENERATED_IMAGE_DIR=./generated_images
# Default mode sends one approved runtime reference image per image_type.
REFERENCE_IMAGE_DIR=./assets/backend_references
IMAGE_JOB_CONCURRENCY=1
IMAGE_JOB_TTL_SECONDS=3600
IMAGE_SOFT_DEADLINE_SECONDS=120
IMAGE_HARD_DEADLINE_SECONDS=150
# Fast generation → critic → up to three guarded, one-region-at-a-time revisions.
ENABLE_FAST_IMAGE_REFINEMENT_PIPELINE=true
IMAGE_AUTO_REVISION_MAX=3
IMAGE_CRITIC_MODEL=qwen3.8-flash
IMAGE_CRITIC_AUTO_BBOX_MIN_CONFIDENCE=0.85
IMAGE_EDIT_MODEL=wan2.7-image-pro
# Initial engineering heuristic; calibrate against representative edit samples.
IMAGE_EDIT_SCOPE_GUARD_THRESHOLD=0.05
IMAGE_EDIT_MIN_INSIDE_CHANGE=0.01
# Human bbox edits: model sees an expanded crop, but only the inward-feathered
# user bbox is writable when the ROI is composited back into trusted pixels.
IMAGE_EDIT_ROI_PADDING_RATIO=0.20
IMAGE_EDIT_MASK_FEATHER_PX=12
IMAGE_EDIT_MIN_BBOX_SIDE_PX=4
IMAGE_EDIT_MIN_BBOX_AREA_PX=64
IMAGE_EDIT_OUTSIDE_PIXEL_TOLERANCE=0
# Reject provider outputs whose aspect ratio no longer matches the ROI canvas.
IMAGE_EDIT_MAX_ASPECT_RATIO_ERROR=0.05
CELL_IP_ENABLED=false
# When true, cell/virus/antigen/antibody topics automatically use the governed skill.
# Startup fails if the governed skill is incomplete.
CELL_IP_SKILL_DIR=../skills/cell-ip-illustrations

# Local RAG knowledge base (PDF corpus under ../RAG)
RAG_SOURCE_DIR=../RAG
RAG_INDEX_DIR=./rag_index
RAG_MODEL_CACHE_DIR=./model_cache
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Fixed upstream commit used by scripts/bootstrap_assets.py; do not replace with "main".
RAG_EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
RAG_EMBEDDING_DEVICE=cpu
RAG_COLLECTION_NAME=vaccine_knowledge
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_FETCH_K=8
RAG_MIN_SIMILARITY=0.60
RAG_MAX_CONTEXT_CHARS=6000
# Frozen RAG V2. Set dense_v1 only for rollback/diagnostics.
RAG_PIPELINE=hybrid_v2
RAG_CORPUS_MANIFEST_PATH=../RAG/corpus_manifest.jsonl
RAG_DOCLING_ARTIFACT_DIR=./runtime/docling_v2
RAG_CHUNKING_VERSION=structure_v2_docling
RAG_DENSE_FETCH_K=50
RAG_LEXICAL_FETCH_K=50
RAG_FUSION_CANDIDATE_K=60
RAG_RRF_K=60
RAG_BM25_K1=1.5
RAG_BM25_B=0.75
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
RAG_RERANKER_DEVICE=cpu
RAG_RERANKER_BATCH_SIZE=16
RAG_RERANKER_MAX_LENGTH=256
RAG_RERANK_CANDIDATE_K=60
RAG_MIN_RELEVANCE=0.0
RAG_WINDOW_RESCORE_ENABLED=true
RAG_WINDOW_RERANKER_MAX_LENGTH=512
RAG_WINDOW_PREV_CHARS=300
RAG_WINDOW_NEXT_CHARS=300
RAG_WINDOW_RERANKER_BATCH_SIZE=8
RAG_NEIGHBOR_SMOOTH_LAMBDA=0.9
RAG_WARMUP_ENABLED=false
RAG_MAX_CONCURRENT_RETRIEVALS=1
RAG_TORCH_NUM_THREADS=2
RAG_TORCH_INTEROP_THREADS=1
EVIDENCE_RULE_MIN_TOP_SCORE=0.90
EVIDENCE_RULE_MIN_SUPPORT_SCORE=0.80
# Relevance remains dominant; authority/evidence component is capped at +/-0.05.
CITATION_ENTAILMENT_AUDIT_ENABLED=true
# Policy-sensitive freshness adds at most +/-0.015; total prior remains clamped to +/-0.10.
RAG_QUALITY_PRIOR_MAX_ADJUSTMENT=0.05
RAG_QUALITY_AUTHORITY_SHARE=0.65
RAG_FRESHNESS_MAX_ADJUSTMENT=0.015
RAG_MAX_CHUNKS_PER_DOCUMENT=3
RAG_NEAR_DUPLICATE_THRESHOLD=0.94

# Provenance-first GraphRAG sidecar. Keep disabled until the active V2 index
# contains a validated graph/ directory built from the same chunks.jsonl.
GRAPH_RAG_ENABLED=false
GRAPH_MAX_HOPS=2
GRAPH_MAX_PATHS=5
GRAPH_CONTEXT_MAX_CHARS=1800
GRAPH_SCHEMA_VERSION=vaccine_graph_v3
GRAPH_EXTRACTION_RULES_VERSION=vaccine_rules_v2
GRAPH_BUILD_ENABLED=true
GRAPH_SNAPSHOT_DIR=./runtime/graph
GRAPH_EXTRACTION_MODEL=qwen3.8-flash
GRAPH_EXTRACTION_MIN_CONFIDENCE=0.60
GRAPH_EXTRACTION_BATCH_SIZE=8
GRAPH_EXTRACTION_BATCH_CHARS=12000
# Extraction has an isolated timeout; it does not change Q&A request timeouts.
GRAPH_EXTRACTION_TIMEOUT=180
GRAPH_EXTRACTION_WORKERS=2
GRAPH_EXTRACTION_PROMPT_VERSION=medical_graph_llm_v4_dense_batches
GRAPH_VALIDATOR_VERSION=medical_graph_validator_v10_dense_batches
GRAPH_WORKER_LEASE_SECONDS=900
GRAPH_WORKER_POLL_SECONDS=2
GRAPH_VISUAL_ASSOCIATION_MAX_PER_CHUNK=3
GRAPH_VISUAL_ASSOCIATION_MAX_DEGREE=4

# 外部医学证据默认开启；默认使用下方 MCP 地址。离线部署可显式设为 false。
PUBMED_ENABLED=true
PUBMED_PROVIDER=mcp
# Streamable HTTP endpoint for cyanheads/pubmed-mcp-server.
PUBMED_MCP_URL=https://pubmed.caseyjhand.com/mcp
# Optional HTTP(S) proxy used only by PubMed MCP/direct traffic. Leave unset by default.
PUBMED_PROXY_URL=
PUBMED_TIMEOUT_SECONDS=20
PUBMED_MAX_RESULTS=5
PUBMED_MAX_QUERY_LENGTH=500
PUBMED_MAX_TOOL_ROUNDS=2
PUBMED_MCP_RETRIES=1
PUBMED_DIRECT_RETRIES=1
PUBMED_CREATE_KNOWLEDGE_GAP=false
# SQLite 审核记录与草稿均位于 runtime；只有管理员 publish 才写入正式 RAG 子目录。
APP_DATABASE_PATH=./runtime/app.db
KNOWLEDGE_DRAFT_DIR=./runtime/knowledge_drafts
RAG_PUBLISHED_SUBDIR=人工审核发布

# 管理端仅使用环境变量账号。密码请保存 Argon2 哈希，禁止填写明文。
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=false
# Reserved for the Direct NCBI provider (Phase 5). Do not commit real values.
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=vaccine-ai-backend
